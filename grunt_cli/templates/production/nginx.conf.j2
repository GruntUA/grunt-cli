# {{ name }} ({{ site }}) — згенеровано `grunt setup production`.
# Повторний запуск команди перезапише цей файл.

upstream {{ key }}_web {
    server 127.0.0.1:{{ port }};
    keepalive 16;
}

map $http_upgrade ${{ key }}_connection {
    default upgrade;
    ''      '';
}

# Cloudflare передає схему відвідувача; без неї — схема цього з'єднання.
map $http_x_forwarded_proto ${{ key }}_proto {
    default $scheme;
    https   https;
}
{% if ssl_cert %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_names }};
    return 301 https://$host$request_uri;
}
{% endif %}
server {
{%- if ssl_cert %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    ssl_certificate     {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};
{%- else %}
    listen 80;
    listen [::]:80;
{%- endif %}
    server_name {{ server_names }};

    client_max_body_size {{ max_body_mb }}m;

    # Справжній IP відвідувача — лише для з'єднань з адрес Cloudflare.
{%- for cidr in cloudflare_ranges %}
    set_real_ip_from {{ cidr }};
{%- endfor %}
    real_ip_header CF-Connecting-IP;

    proxy_http_version 1.1;

    location /api/v1/ws/ {
        proxy_pass http://{{ key }}_web;
        # $remote_addr тут уже справжній IP; заголовки від клієнта перезаписуємо,
        # щоб запит напряму на сервер не міг підробити адресу. (proxy_set_header
        # не успадковується з server, якщо в location є свій — тому тут.)
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header CF-Connecting-IP  $remote_addr;
        proxy_set_header X-Forwarded-Proto ${{ key }}_proto;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        ${{ key }}_connection;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://{{ key }}_web;
        # $remote_addr тут уже справжній IP; заголовки від клієнта перезаписуємо,
        # щоб запит напряму на сервер не міг підробити адресу. (proxy_set_header
        # не успадковується з server, якщо в location є свій — тому тут.)
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header CF-Connecting-IP  $remote_addr;
        proxy_set_header X-Forwarded-Proto ${{ key }}_proto;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
    }
}
