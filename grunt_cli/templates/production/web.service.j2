# {{ name }} ({{ site }}) — згенеровано `grunt setup production`.
[Unit]
Description=Grunt web — {{ site }}
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User={{ user }}
WorkingDirectory={{ grunt_dir }}
Environment=DOTENV_PATH={{ env_file }}
Environment=PATH={{ grunt_dir }}/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Кілька процесів ділять Redis: кеші, rate limit, присутність; cron запускає лише лідер.
ExecStart={{ grunt_dir }}/.venv/bin/uvicorn grunt.main:app --host 127.0.0.1 --port {{ port }} --proxy-headers --forwarded-allow-ips 127.0.0.1{% if web_workers > 1 %} --workers {{ web_workers }}{% endif %}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
